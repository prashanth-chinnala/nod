# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
# MuseTalk runs on Python 3.10 with numpy<2 and a pinned diffusers/transformers pair, none of
# which the runtime's own environment can hold -- `opencv-python` compiled against numpy 1.x
# hard-fails against the numpy 2 that torch pulls in. So it gets its own interpreter. The
# `.venv/` rule above does not match a suffixed name, which is why this line exists.
.venv-musetalk/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Model weights — never commit. See README for the download script.
models/
weights/
checkpoints/
