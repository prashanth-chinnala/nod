# Copy to .env and fill in. .env is gitignored; this file is committed.
# Loaded automatically at server import by avatar.config.
# A real environment variable always wins over anything set here.
#
# Every default below is a working, no-credential one — a clean clone runs with
# no .env at all, using placeholders for the LLM, TTS, transcriber, and renderer.

# --- which implementation each boundary resolves to ------------------------
AVATAR_RENDERER=stub        # stub | <model>       (stub needs no GPU)
AVATAR_LLM=scripted         # scripted | openai | anthropic
AVATAR_TTS=tone             # tone | deepgram
AVATAR_STT=none             # none | deepgram
AVATAR_VAD=energy           # energy | silero      (silero needs .[vad])

# --- LLM ------------------------------------------------------------------
# OPENAI_BASE_URL lets AVATAR_LLM=openai reach anything OpenAI-compatible:
#   Ollama Cloud   https://ollama.com/v1
#   local Ollama   http://localhost:11434/v1        (no key needed)
#   LM Studio      http://localhost:1234/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AVATAR_LLM_MODEL=
# ANTHROPIC_API_KEY=

# --- speech in and out ----------------------------------------------------
# DEEPGRAM_API_KEY=
# AVATAR_TTS_VOICE=aura-2-thalia-en

# --- the renderer's reference persona -------------------------------------
# AVATAR_REFERENCE=assets/reference.mp4
